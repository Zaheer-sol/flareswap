# ---------------------------------------------------------------------------
# FlareSwap relayer + price API
# Copy to .env and fill in. Everything with a default can be left out.
# ---------------------------------------------------------------------------

# --- Flare -----------------------------------------------------------------
CHAIN_ID=114
FLARE_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
# Operator key that submits attestation requests and settlement transactions.
# Needs C2FLR for gas and for FDC request fees.
RELAYER_PRIVATE_KEY=0x...

# --- XRPL ------------------------------------------------------------------
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
# The address users deposit into. MUST match what was configured on IntentManager
# at deploy time — the settler checks keccak256(bytes(address)) against the FDC proof.
XRPL_DEPOSIT_ADDRESS=rXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# FDC source id: "testXRP" on XRPL testnet, "XRP" on mainnet.
XRPL_SOURCE_ID=testXRP
# Ledger confirmations to wait for before requesting an attestation.
XRPL_CONFIRMATIONS=1

# --- Flare Data Connector --------------------------------------------------
# Verifier server that turns a transaction id into an ABI-encoded attestation request.
FDC_VERIFIER_URL=https://fdc-verifiers-testnet.flare.network
FDC_VERIFIER_API_KEY=
# Data Availability layer that serves Merkle proofs once a round is finalised.
FDC_DA_LAYER_URL=https://ctn2-data-availability.flare.network
FDC_DA_LAYER_API_KEY=
# FDC runs as protocol 200 on the Relay contract.
FDC_PROTOCOL_ID=200

# --- API -------------------------------------------------------------------
PORT=4000
CORS_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/flareswap.db

# --- Tuning ----------------------------------------------------------------
# FTSO feeds update at block latency (~1.8s); polling faster just wastes RPC calls.
PRICE_POLL_INTERVAL_MS=2000
RELAYER_TICK_INTERVAL_MS=5000
INDEXER_POLL_INTERVAL_MS=5000
# How far back to scan for IntentCreated events on a cold start. 0 = from deployment block.
INDEXER_START_BLOCK=0
LOG_LEVEL=info
